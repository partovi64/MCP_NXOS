# NX-OS credentials (never commit real values)
NXOS_USERNAME=netops-ro
NXOS_PASSWORD=change-me

# Paths (relative to CWD or absolute)
NXOS_INVENTORY=config/inventory.yaml
NXOS_GUARDRAILS=config/guardrails.yaml
NXOS_REDACTION=config/redaction.yaml

# Transport: stdio (default) | streamable-http
NXOS_TRANSPORT=stdio
NXOS_HTTP_HOST=127.0.0.1
NXOS_HTTP_PORT=8080
# Required when using streamable-http
NXOS_HTTP_BEARER_TOKEN=

# TLS / lab
NXOS_ALLOW_INSECURE=false
NXOS_CA_BUNDLE=
NXOS_ALLOW_HTTP=false

# Runtime
NXOS_DRY_RUN=false
NXOS_LOG_LEVEL=INFO
NXOS_AUDIT_LOG_PATH=logs/audit.jsonl
NXOS_MAX_OUTPUT_BYTES=65536
NXOS_MAX_FANOUT=10

# Integration tests only
NXOS_INTEGRATION=0
NXOS_INTEGRATION_DEVICE=
